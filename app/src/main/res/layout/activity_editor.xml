<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/btnRevert"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_press"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Revert"
                android:textColor="#555555"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_press"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Save"
                android:textColor="#555555"
                android:textSize="14sp" />
        </LinearLayout>

        <com.example.gallery.EditorView
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/panelHost"
            android:layout_width="match_parent"
            android:layout_height="150dp">

            <!-- DRAW -->
            <LinearLayout
                android:id="@+id/panelDraw"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/toolPen"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tool"
                        android:contentDescription="Pen"
                        android:padding="9dp"
                        android:src="@drawable/ic_edit_o" />

                    <ImageView
                        android:id="@+id/toolHl"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tool"
                        android:contentDescription="Highlighter"
                        android:padding="9dp"
                        android:src="@drawable/ic_highlighter" />

                    <ImageView
                        android:id="@+id/toolDot"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tool"
                        android:contentDescription="Dotted pen"
                        android:padding="9dp"
                        android:src="@drawable/ic_dotted" />

                    <ImageView
                        android:id="@+id/toolEraser"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tool"
                        android:contentDescription="Eraser"
                        android:padding="9dp"
                        android:src="@drawable/ic_eraser" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="#44FFFFFF" />

                    <ImageView
                        android:id="@+id/btnUndo"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tool"
                        android:contentDescription="Undo"
                        android:padding="9dp"
                        android:src="@drawable/ic_undo" />

                    <ImageView
                        android:id="@+id/btnRedo"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tool"
                        android:contentDescription="Redo"
                        android:padding="9dp"
                        android:src="@drawable/ic_redo" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp">

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/colorRowDraw"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <SeekBar
                        android:id="@+id/sizeDraw"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:max="48"
                        android:progressBackgroundTint="#44FFFFFF"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />
                </LinearLayout>
            </LinearLayout>

            <!-- STICKERS -->
            <LinearLayout
                android:id="@+id/panelSticker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/stickerRow"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/btnStickerDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Delete sticker"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- TEXT -->
            <LinearLayout
                android:id="@+id/panelText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnAddText"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="Add text"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/itemActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <TextView
                        android:id="@+id/btnTextEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Edit text"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnTextDelete"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Delete"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CROP -->
            <LinearLayout
                android:id="@+id/panelCrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/btnRot90"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tool"
                        android:contentDescription="Rotate 90 degrees"
                        android:padding="9dp"
                        android:src="@drawable/ic_rotate90" />

                    <ImageView
                        android:id="@+id/btnFlipH"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tool"
                        android:contentDescription="Flip horizontally"
                        android:padding="9dp"
                        android:src="@drawable/ic_flip_h" />

                    <ImageView
                        android:id="@+id/btnFlipV"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tool"
                        android:contentDescription="Flip vertically"
                        android:padding="9dp"
                        android:src="@drawable/ic_flip_v" />

                    <TextView
                        android:id="@+id/btnAspect"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:minWidth="72dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Free"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btnCropReset"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tool"
                        android:contentDescription="Reset crop and rotation"
                        android:padding="9dp"
                        android:src="@drawable/ic_history" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <TextView
                        android:id="@+id/angleText"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0°"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/angleSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="90"
                        android:progress="45"
                        android:progressBackgroundTint="#44FFFFFF"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />
                </LinearLayout>
            </LinearLayout>

            <!-- FILTERS -->
            <HorizontalScrollView
                android:id="@+id/panelFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/filterRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- ADJUST -->
            <LinearLayout
                android:id="@+id/panelAdjust"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/adjRow"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:id="@+id/adjLabel"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/adjSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="200"
                        android:progress="100"
                        android:progressBackgroundTint="#44FFFFFF"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/btnAdjReset"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Reset"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnAdjResetAll"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Reset all"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/catRow"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/catDraw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Draw"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/catSticker"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Stickers"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/catText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Text"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tEnhance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="Enhance"
                android:padding="16dp"
                android:src="@drawable/ic_enhance" />

            <ImageView
                android:id="@+id/tCrop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="Crop and rotate"
                android:padding="16dp"
                android:src="@drawable/ic_crop_rotate" />

            <ImageView
                android:id="@+id/tFilters"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="Filters"
                android:padding="16dp"
                android:src="@drawable/ic_filters" />

            <ImageView
                android:id="@+id/tAdjust"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="Adjustments"
                android:padding="16dp"
                android:src="@drawable/ic_adjust" />

            <ImageView
                android:id="@+id/tDecor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="Draw, stickers and text"
                android:padding="16dp"
                android:src="@drawable/ic_smiley" />

            <ImageView
                android:id="@+id/tMore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="More tools"
                android:padding="16dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/saving"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />
    </FrameLayout>
</FrameLayout>