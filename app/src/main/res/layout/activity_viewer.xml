<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/videoHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">

        <com.example.gallery.VideoPlayerView
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_press"
            android:contentDescription="Back"
            android:padding="16dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnPlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_press"
            android:contentDescription="Play slideshow"
            android:padding="16dp"
            android:src="@drawable/ic_play"
            android:visibility="gone"
            app:tint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/videoControls"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnFull"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Hide controls"
                android:padding="10dp"
                android:src="@drawable/ic_fullscreen"
                android:visibility="invisible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/btnPill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/btnToggle"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Play"
                    android:src="@drawable/ic_play" />

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="00:00 / 00:00"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnMute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_outline"
                android:contentDescription="Mute"
                android:padding="10dp"
                android:src="@drawable/ic_volume_on" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timelinePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnCollapse"
                android:layout_width="56dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_press"
                android:contentDescription="Collapse timeline"
                android:padding="2dp"
                android:src="@drawable/ic_expand_more" />

            <com.example.gallery.TimelineView
                android:id="@+id/expTimeline"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="4dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filmstrip"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnFav"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="Favourite"
                android:padding="14dp"
                android:src="@drawable/ic_favorite_border" />

            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="Edit"
                android:padding="14dp"
                android:src="@drawable/ic_edit_o"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="Share"
                android:padding="14dp"
                android:src="@drawable/ic_share_o"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="Delete"
                android:padding="14dp"
                android:src="@drawable/ic_trash_o"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_press"
                android:contentDescription="More options"
                android:padding="14dp"
                android:src="@drawable/ic_more"
                app:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/trashBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnTrashRestore"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_capsule_ripple"
                android:gravity="center"
                android:minWidth="120dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Restore"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnTrashDelete"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_capsule_ripple"
                android:gravity="center"
                android:minWidth="120dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Delete"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>